{
  "name": "openflow",
  "version": "0.3.0",
  "author": "LuiInventions",
  "license": "GPL-3.0-only",
  "description": "Local-first voice dictation, notes, and screenshot dock for Windows. Includes local open-source Parakeet v3 STT and optional OpenAI API support.",
  "main": "electron/main.cjs",
  "scripts": {
    "start": "electron .",
    "test": "node --test test/flow.test.js test/providers.test.js test/store.test.js test/cues.test.js test/audio.test.js test/shot.test.js",
    "assets": "node scripts/write-assets.js",
    "dist": "electron-builder --win nsis"
  },
  "engines": {
    "node": ">=22"
  },
  "build": {
    "appId": "local.openflow.desk",
    "productName": "OpenFlow",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "electron/**/*",
      "renderer/**/*",
      "src/**/*",
      "node_modules/sherpa-onnx-*/**/*",
      "build/icon.png",
      "build/icon.ico",
      "package.json"
    ],
    "asar": true,
    "asarUnpack": [
      "**/node_modules/sherpa-onnx-*/**/*"
    ],
    "extraResources": [
      {
        "from": "vendor/flameshot/flameshot-14.0.0-win64",
        "to": "flameshot"
      }
    ],
    "win": {
      "target": [
        "nsis"
      ],
      "icon": "build/icon.png",
      "signExecutable": false,
      "requestedExecutionLevel": "asInvoker"
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "runAfterFinish": true,
      "shortcutName": "OpenFlow",
      "artifactName": "OpenFlow-Setup-${version}.exe"
    }
  },
  "devDependencies": {
    "electron": "37.10.3",
    "electron-builder": "26.15.3"
  },
  "dependencies": {
    "sherpa-onnx-node": "^1.13.8"
  }
}
